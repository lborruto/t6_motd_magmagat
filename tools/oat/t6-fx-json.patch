+#pragma once
+
+#include <string>
+
+namespace fx
+{
+    // An effect "a/b/c" lives in "fx/a/b/c.json": the FxEffectDef written field for field (tools/fx in the Magmagat mod)
+    std::string GetJsonFileNameForAssetNameT6(const std::string& assetName);
