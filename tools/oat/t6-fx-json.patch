diff --git a/src/ObjLoading/Game/T6/Fx/FxJsonLoaderT6.cpp b/src/ObjLoading/Game/T6/Fx/FxJsonLoaderT6.cpp
new file mode 100644
index 00000000..0d1bec86
--- /dev/null
+++ b/src/ObjLoading/Game/T6/Fx/FxJsonLoaderT6.cpp
@@ -0,0 +1,383 @@
+#include "FxJsonLoaderT6.h"
+
+#include "Game/T6/Fx/FxCommonT6.h"
+#include "Game/T6/T6.h"
+#include "Utils/Logging/Log.h"
+
+#include <format>
+#include <nlohmann/json.hpp>
+#include <stdexcept>
+
+using namespace nlohmann;
+using namespace T6;
+
+namespace
+{
+    class FxError final : public std::runtime_error
+    {
+    public:
+        explicit FxError(const std::string& message)
+            : std::runtime_error(message)
+        {
+        }
+    };
+
+    class JsonLoader
+    {
+    public:
+        JsonLoader(MemoryManager& memory, AssetCreationContext& context, AssetRegistration<AssetFx>& registration)
+            : m_memory(memory),
+              m_context(context),
+              m_registration(registration)
+        {
+        }
+
+        void Load(const json& j, FxEffectDef& fx) const
+        {
+            if (j.at("_type").get<std::string>() != "fx" || j.at("_version").get<unsigned>() != 1u)
+                throw FxError("expected _type fx of _version 1");
+
+            fx.flags = j.at("flags").get<uint16_t>();
+            fx.efPriority = static_cast<char>(j.at("efPriority").get<int>());
+            fx.elemDefCountLooping = j.at("elemDefCountLooping").get<int16_t>();
+            fx.elemDefCountOneShot = j.at("elemDefCountOneShot").get<int16_t>();
+            fx.elemDefCountEmission = j.at("elemDefCountEmission").get<int16_t>();
+            fx.totalSize = j.at("totalSize").get<int>();
+            fx.msecLoopingLife = j.at("msecLoopingLife").get<int>();
+            fx.msecNonLoopingLife = j.at("msecNonLoopingLife").get<int>();
+            Vec(j.at("boundingBoxDim"), fx.boundingBoxDim.v, 3);
+            Vec(j.at("boundingBoxCentre"), fx.boundingBoxCentre.v, 3);
+            fx.occlusionQueryDepthBias = j.at("occlusionQueryDepthBias").get<float>();
+            fx.occlusionQueryFadeIn = j.at("occlusionQueryFadeIn").get<int>();
+            fx.occlusionQueryFadeOut = j.at("occlusionQueryFadeOut").get<int>();
+            Range(j.at("occlusionQueryScaleRange"), fx.occlusionQueryScaleRange);
+
+            const auto& elems = j.at("elemDefs");
+            const auto count = fx.elemDefCountLooping + fx.elemDefCountOneShot + fx.elemDefCountEmission;
+            if (static_cast<size_t>(count) != elems.size())
+                throw FxError(std::format("the elem counts add up to {} but elemDefs has {}", count, elems.size()));
+
+            fx.elemDefs = count > 0 ? m_memory.Alloc<FxElemDef>(count) : nullptr;
+            for (auto i = 0; i < count; i++)
+                ElemDef(elems[i], fx.elemDefs[i]);
+        }
+
+    private:
+        static void Vec(const json& j, float* out, const size_t n)
+        {
+            if (j.size() != n)
+                throw FxError(std::format("expected {} numbers", n));
+
+            for (auto i = 0u; i < n; i++)
+                out[i] = j[i].get<float>();
+        }
+
+        static void Range(const json& j, FxFloatRange& r)
+        {
+            r.base = j.at(0).get<float>();
+            r.amplitude = j.at(1).get<float>();
+        }
+
+        static void Range(const json& j, FxIntRange& r)
+        {
+            r.base = j.at(0).get<int>();
+            r.amplitude = j.at(1).get<int>();
+        }
+
+        static void Vec3Range(const json& j, FxElemVec3Range& r)
+        {
+            Vec(j.at("base"), r.base.v, 3);
+            Vec(j.at("amplitude"), r.amplitude.v, 3);
+        }
+
+        static void VelFrame(const json& j, FxElemVelStateInFrame& f)
+        {
+            Vec3Range(j.at("velocity"), f.velocity);
+            Vec3Range(j.at("totalDelta"), f.totalDelta);
+        }
+
+        static void VisState(const json& j, FxElemVisualState& s)
+        {
+            const auto& c = j.at("color");
+            for (auto i = 0; i < 4; i++)
+                s.color[i] = static_cast<char>(c.at(i).get<int>());
+            s.rotationDelta = j.at("rotationDelta").get<float>();
+            s.rotationTotal = j.at("rotationTotal").get<float>();
+            s.size[0] = j.at("size").at(0).get<float>();
+            s.size[1] = j.at("size").at(1).get<float>();
+            s.scale = j.at("scale").get<float>();
+        }
+
+        const char* OptString(const json& j) const
+        {
+            if (j.is_null())
+                return nullptr;
+
+            return m_memory.Dup(j.get<std::string>().c_str());
+        }
+
+        Material* LoadMaterial(const json& j) const
+        {
+            if (j.is_null())
+                return nullptr;
+
+            const auto name = j.get<std::string>();
+            auto* material = m_context.LoadDependency<AssetMaterial>(name);
+            if (!material)
+                throw FxError(std::format("could not find material \"{}\"", name));
+
+            m_registration.AddDependency(material);
+            return material->Asset();
+        }
+
+        // an effect named by an element (runner, impact, death, emitted, attached): a reference by name
+        void EffectRef(const json& j, FxEffectDefRef& ref) const
+        {
+            ref.name = nullptr;
+            if (j.is_null())
+                return;
+
+            const auto name = j.get<std::string>();
+            ref.name = m_memory.Dup(name.c_str());
+            m_registration.AddIndirectAssetReference(m_context.LoadIndirectAssetReference<AssetFx>(name));
+        }
+
+        void Visual(const json& j, FxElemVisuals& v, const FxElemType type) const
+        {
+            v.anonymous = nullptr;
+            if (j.is_null())
+                return;
+
+            const auto name = j.get<std::string>();
+            switch (type)
+            {
+            case FX_ELEM_TYPE_MODEL:
+            {
+                auto* model = m_context.LoadDependency<AssetXModel>(name);
+                if (!model)
+                    throw FxError(std::format("could not find xmodel \"{}\"", name));
+                m_registration.AddDependency(model);
+                v.model = model->Asset();
+                break;
+            }
+            case FX_ELEM_TYPE_RUNNER:
+                EffectRef(j, v.effectDef);
+                break;
+            case FX_ELEM_TYPE_SOUND:
+                v.soundName = m_memory.Dup(name.c_str());
+                break;
+            case FX_ELEM_TYPE_SPOT_LIGHT:
+            {
+                auto* light = m_context.LoadDependency<AssetLightDef>(name);
+                if (!light)
+                    throw FxError(std::format("could not find lightdef \"{}\"", name));
+                m_registration.AddDependency(light);
+                v.lightDef = light->Asset();
+                break;
+            }
+            case FX_ELEM_TYPE_OMNI_LIGHT:
+                break;
+            default:
+                v.material = LoadMaterial(j);
+                break;
+            }
+        }
+
+        void ElemDef(const json& j, FxElemDef& e) const
+        {
+            e.flags = j.at("flags").get<int>();
+            e.spawn.looping.intervalMsec = j.at("spawn").at(0).get<int>();
+            e.spawn.looping.count = j.at("spawn").at(1).get<int>();
+            Range(j.at("spawnRange"), e.spawnRange);
+            Range(j.at("fadeInRange"), e.fadeInRange);
+            Range(j.at("fadeOutRange"), e.fadeOutRange);
+            e.spawnFrustumCullRadius = j.at("spawnFrustumCullRadius").get<float>();
+            Range(j.at("spawnDelayMsec"), e.spawnDelayMsec);
+            Range(j.at("lifeSpanMsec"), e.lifeSpanMsec);
+            for (auto i = 0; i < 3; i++)
+                Range(j.at("spawnOrigin").at(i), e.spawnOrigin[i]);
+            Range(j.at("spawnOffsetRadius"), e.spawnOffsetRadius);
+            Range(j.at("spawnOffsetHeight"), e.spawnOffsetHeight);
+            for (auto i = 0; i < 3; i++)
+            {
+                Range(j.at("spawnAngles").at(i), e.spawnAngles[i]);
+                Range(j.at("angularVelocity").at(i), e.angularVelocity[i]);
+            }
+            Range(j.at("initialRotation"), e.initialRotation);
+            e.rotationAxis = j.at("rotationAxis").get<unsigned>();
+            Range(j.at("gravity"), e.gravity);
+            Range(j.at("reflectionFactor"), e.reflectionFactor);
+
+            const auto& a = j.at("atlas");
+            e.atlas.behavior = static_cast<char>(a.at("behavior").get<int>());
+            e.atlas.index = static_cast<char>(a.at("index").get<int>());
+            e.atlas.fps = static_cast<char>(a.at("fps").get<int>());
+            e.atlas.loopCount = static_cast<char>(a.at("loopCount").get<int>());
+            e.atlas.colIndexBits = static_cast<char>(a.at("colIndexBits").get<int>());
+            e.atlas.rowIndexBits = static_cast<char>(a.at("rowIndexBits").get<int>());
+            e.atlas.entryCountAndIndexRange = a.at("entryCountAndIndexRange").get<uint16_t>();
+
+            e.windInfluence = j.at("windInfluence").get<float>();
+            const auto type = j.at("elemType").get<int>();
+            if (type < 0 || type >= FX_ELEM_TYPE_COUNT)
+                throw FxError(std::format("elemType {} is not a T6 element type", type));
+            e.elemType = static_cast<FxElemType>(type);
+
+            // the zone writes velIntervalCount + 1 / visStateIntervalCount + 1 samples
+            const auto& vel = j.at("velSamples");
+            const auto& vis = j.at("visSamples");
+            if (vel.empty() || vis.empty())
+                throw FxError("an element needs at least one velSample and one visSample");
+            e.velIntervalCount = static_cast<char>(vel.size() - 1);
+            e.visStateIntervalCount = static_cast<char>(vis.size() - 1);
+            e.velSamples = m_memory.Alloc<FxElemVelStateSample>(vel.size());
+            for (auto i = 0u; i < vel.size(); i++)
+            {
+                VelFrame(vel[i].at("local"), e.velSamples[i].local);
+                VelFrame(vel[i].at("world"), e.velSamples[i].world);
+            }
+            e.visSamples = m_memory.Alloc<FxElemVisStateSample>(vis.size());
+            for (auto i = 0u; i < vis.size(); i++)
+            {
+                VisState(vis[i].at("base"), e.visSamples[i].base);
+                VisState(vis[i].at("amplitude"), e.visSamples[i].amplitude);
+            }
+
+            const auto& visuals = j.at("visuals");
+            e.visualCount = static_cast<char>(visuals.size());
+            e.visuals.instance.anonymous = nullptr;
+            if (e.elemType == FX_ELEM_TYPE_DECAL)
+            {
+                if (!visuals.empty())
+                {
+                    e.visuals.markArray = m_memory.Alloc<FxElemMarkVisuals>(visuals.size());
+                    for (auto i = 0u; i < visuals.size(); i++)
+                    {
+                        e.visuals.markArray[i].materials[0] = LoadMaterial(visuals[i].at(0));
+                        e.visuals.markArray[i].materials[1] = LoadMaterial(visuals[i].at(1));
+                    }
+                }
+            }
+            else if (visuals.size() > 1)
+            {
+                e.visuals.array = m_memory.Alloc<FxElemVisuals>(visuals.size());
+                for (auto i = 0u; i < visuals.size(); i++)
+                    Visual(visuals[i], e.visuals.array[i], e.elemType);
+            }
+            else if (visuals.size() == 1)
+                Visual(visuals[0], e.visuals.instance, e.elemType);
+
+            Vec(j.at("collMins"), e.collMins.v, 3);
+            Vec(j.at("collMaxs"), e.collMaxs.v, 3);
+            EffectRef(j.at("effectOnImpact"), e.effectOnImpact);
+            EffectRef(j.at("effectOnDeath"), e.effectOnDeath);
+            EffectRef(j.at("effectEmitted"), e.effectEmitted);
+            Range(j.at("emitDist"), e.emitDist);
+            Range(j.at("emitDistVariance"), e.emitDistVariance);
+            EffectRef(j.at("effectAttached"), e.effectAttached);
+
+            e.extended.unknownDef = nullptr;
+            if (e.elemType == FX_ELEM_TYPE_TRAIL)
+            {
+                const auto& t = j.at("trail");
+                auto* trail = m_memory.Alloc<FxTrailDef>();
+                trail->scrollTimeMsec = t.at("scrollTimeMsec").get<int>();
+                trail->repeatDist = t.at("repeatDist").get<int>();
+                trail->splitDist = t.at("splitDist").get<int>();
+                const auto& verts = t.at("verts");
+                const auto& inds = t.at("inds");
+                trail->vertCount = static_cast<int>(verts.size());
+                trail->verts = trail->vertCount > 0 ? m_memory.Alloc<FxTrailVertex>(verts.size()) : nullptr;
+                for (auto i = 0u; i < verts.size(); i++)
+                {
+                    trail->verts[i].pos.x = verts[i].at(0).get<float>();
+                    trail->verts[i].pos.y = verts[i].at(1).get<float>();
+                    trail->verts[i].normal.x = verts[i].at(2).get<float>();
+                    trail->verts[i].normal.y = verts[i].at(3).get<float>();
+                    trail->verts[i].texCoord = verts[i].at(4).get<float>();
+                }
+                trail->indCount = static_cast<int>(inds.size());
+                trail->inds = trail->indCount > 0 ? m_memory.Alloc<uint16_t>(inds.size()) : nullptr;
+                for (auto i = 0u; i < inds.size(); i++)
+                    trail->inds[i] = inds[i].get<uint16_t>();
+                e.extended.trailDef = trail;
+            }
+            else if (e.elemType == FX_ELEM_TYPE_SPOT_LIGHT)
+            {
+                const auto& s = j.at("spotLight");
+                auto* spot = m_memory.Alloc<FxSpotLightDef>();
+                spot->fovInnerFraction = s.at("fovInnerFraction").get<float>();
+                spot->startRadius = s.at("startRadius").get<float>();
+                spot->endRadius = s.at("endRadius").get<float>();
+                e.extended.spotLightDef = spot;
+            }
+
+            e.sortOrder = static_cast<char>(j.at("sortOrder").get<int>());
+            e.lightingFrac = static_cast<char>(j.at("lightingFrac").get<int>());
+            e.alphaFadeTimeMsec = j.at("alphaFadeTimeMsec").get<uint16_t>();
+            e.maxWindStrength = j.at("maxWindStrength").get<uint16_t>();
+            e.spawnIntervalAtMaxWind = j.at("spawnIntervalAtMaxWind").get<uint16_t>();
+            e.lifespanAtMaxWind = j.at("lifespanAtMaxWind").get<uint16_t>();
+            if (e.elemType == FX_ELEM_TYPE_CLOUD)
+                Range(j.at("cloudDensityRange"), e.u.cloudDensityRange);
+            else
+            {
+                e.u.billboard.topWidth = j.at("billboardTrim").at(0).get<float>();
+                e.u.billboard.bottomWidth = j.at("billboardTrim").at(1).get<float>();
+            }
+            e.spawnSound.spawnSound = OptString(j.at("spawnSound"));
+            e.billboardPivot.x = j.at("billboardPivot").at(0).get<float>();
+            e.billboardPivot.y = j.at("billboardPivot").at(1).get<float>();
+        }
+
+        MemoryManager& m_memory;
+        AssetCreationContext& m_context;
+        AssetRegistration<AssetFx>& m_registration;
+    };
+
+    class FxLoader final : public AssetCreator<AssetFx>
+    {
+    public:
+        FxLoader(MemoryManager& memory, ISearchPath& searchPath)
+            : m_memory(memory),
+              m_search_path(searchPath)
+        {
+        }
+
+        AssetCreationResult CreateAsset(const std::string& assetName, AssetCreationContext& context) override
+        {
+            const auto file = m_search_path.Open(fx::GetJsonFileNameForAssetNameT6(assetName));
+            if (!file.IsOpen())
+                return AssetCreationResult::NoAction();
+
+            auto* fx = m_memory.Alloc<FxEffectDef>();
+            fx->name = m_memory.Dup(assetName.c_str());
+            AssetRegistration<AssetFx> registration(assetName, fx);
+
+            try
+            {
+                const JsonLoader loader(m_memory, context, registration);
+                loader.Load(json::parse(*file.m_stream), *fx);
+            }
+            catch (const std::exception& e)
+            {
+                con::error("Failed to load fx \"{}\": {}", assetName, e.what());
+                return AssetCreationResult::Failure();
+            }
+
+            return AssetCreationResult::Success(context.AddAsset(std::move(registration)));
+        }
+
+    private:
+        MemoryManager& m_memory;
+        ISearchPath& m_search_path;
+    };
+} // namespace
+
+namespace fx
+{
+    std::unique_ptr<AssetCreator<AssetFx>> CreateJsonLoaderT6(MemoryManager& memory, ISearchPath& searchPath)
+    {
+        return std::make_unique<FxLoader>(memory, searchPath);
+    }
+} // namespace fx
