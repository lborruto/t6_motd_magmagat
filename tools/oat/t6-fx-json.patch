diff --git a/src/ObjWriting/Game/T6/Fx/FxJsonDumperT6.cpp b/src/ObjWriting/Game/T6/Fx/FxJsonDumperT6.cpp
new file mode 100644
index 00000000..0751bdcd
--- /dev/null
+++ b/src/ObjWriting/Game/T6/Fx/FxJsonDumperT6.cpp
@@ -0,0 +1,243 @@
+#include "FxJsonDumperT6.h"
+
+#include "Game/T6/Fx/FxCommonT6.h"
+
+#include <iomanip>
+#include <nlohmann/json.hpp>
+
+using namespace nlohmann;
+using namespace T6;
+
+namespace
+{
+    const char* AssetName(const char* input)
+    {
+        if (input && input[0] == ',')
+            return &input[1];
+
+        return input;
+    }
+
+    json Str(const char* s)
+    {
+        if (!s)
+            return nullptr;
+
+        return AssetName(s);
+    }
+
+    json Range(const FxFloatRange& r)
+    {
+        return json::array({r.base, r.amplitude});
+    }
+
+    json Range(const FxIntRange& r)
+    {
+        return json::array({r.base, r.amplitude});
+    }
+
+    json Vec(const float* v, const int n)
+    {
+        auto j = json::array();
+        for (auto i = 0; i < n; i++)
+            j.push_back(v[i]);
+
+        return j;
+    }
+
+    json Vec3Range(const FxElemVec3Range& r)
+    {
+        return json{{"base", Vec(r.base.v, 3)}, {"amplitude", Vec(r.amplitude.v, 3)}};
+    }
+
+    json VelFrame(const FxElemVelStateInFrame& f)
+    {
+        return json{{"velocity", Vec3Range(f.velocity)}, {"totalDelta", Vec3Range(f.totalDelta)}};
+    }
+
+    json VisState(const FxElemVisualState& s)
+    {
+        return json{
+            {"color",
+             json::array({static_cast<uint8_t>(s.color[0]), static_cast<uint8_t>(s.color[1]), static_cast<uint8_t>(s.color[2]), static_cast<uint8_t>(s.color[3])})},
+            {"rotationDelta", s.rotationDelta},
+            {"rotationTotal", s.rotationTotal},
+            {"size", json::array({s.size[0], s.size[1]})},
+            {"scale", s.scale},
+        };
+    }
+
+    json Visual(const FxElemVisuals& v, const FxElemType type)
+    {
+        if (!v.anonymous)
+            return nullptr;
+
+        switch (type)
+        {
+        case FX_ELEM_TYPE_MODEL:
+            return Str(v.model->name);
+        case FX_ELEM_TYPE_RUNNER:
+            return Str(v.effectDef.name);
+        case FX_ELEM_TYPE_SOUND:
+            return Str(v.soundName);
+        case FX_ELEM_TYPE_SPOT_LIGHT:
+            return Str(v.lightDef->name);
+        case FX_ELEM_TYPE_OMNI_LIGHT:
+            return nullptr;
+        default:
+            return Str(v.material->info.name);
+        }
+    }
+
+    json ElemDef(const FxElemDef& e)
+    {
+        json j;
+        j["flags"] = e.flags;
+        j["spawn"] = json::array({e.spawn.looping.intervalMsec, e.spawn.looping.count});
+        j["spawnRange"] = Range(e.spawnRange);
+        j["fadeInRange"] = Range(e.fadeInRange);
+        j["fadeOutRange"] = Range(e.fadeOutRange);
+        j["spawnFrustumCullRadius"] = e.spawnFrustumCullRadius;
+        j["spawnDelayMsec"] = Range(e.spawnDelayMsec);
+        j["lifeSpanMsec"] = Range(e.lifeSpanMsec);
+        j["spawnOrigin"] = json::array({Range(e.spawnOrigin[0]), Range(e.spawnOrigin[1]), Range(e.spawnOrigin[2])});
+        j["spawnOffsetRadius"] = Range(e.spawnOffsetRadius);
+        j["spawnOffsetHeight"] = Range(e.spawnOffsetHeight);
+        j["spawnAngles"] = json::array({Range(e.spawnAngles[0]), Range(e.spawnAngles[1]), Range(e.spawnAngles[2])});
+        j["angularVelocity"] = json::array({Range(e.angularVelocity[0]), Range(e.angularVelocity[1]), Range(e.angularVelocity[2])});
+        j["initialRotation"] = Range(e.initialRotation);
+        j["rotationAxis"] = e.rotationAxis;
+        j["gravity"] = Range(e.gravity);
+        j["reflectionFactor"] = Range(e.reflectionFactor);
+        j["atlas"] = json{
+            {"behavior", static_cast<int>(e.atlas.behavior)},
+            {"index", static_cast<int>(e.atlas.index)},
+            {"fps", static_cast<int>(e.atlas.fps)},
+            {"loopCount", static_cast<int>(e.atlas.loopCount)},
+            {"colIndexBits", static_cast<int>(e.atlas.colIndexBits)},
+            {"rowIndexBits", static_cast<int>(e.atlas.rowIndexBits)},
+            {"entryCountAndIndexRange", e.atlas.entryCountAndIndexRange},
+        };
+        j["windInfluence"] = e.windInfluence;
+        j["elemType"] = static_cast<int>(e.elemType);
+
+        auto vel = json::array();
+        if (e.velSamples)
+        {
+            for (auto i = 0; i <= e.velIntervalCount; i++)
+                vel.push_back(json{{"local", VelFrame(e.velSamples[i].local)}, {"world", VelFrame(e.velSamples[i].world)}});
+        }
+        j["velSamples"] = vel;
+
+        auto vis = json::array();
+        if (e.visSamples)
+        {
+            for (auto i = 0; i <= e.visStateIntervalCount; i++)
+                vis.push_back(json{{"base", VisState(e.visSamples[i].base)}, {"amplitude", VisState(e.visSamples[i].amplitude)}});
+        }
+        j["visSamples"] = vis;
+
+        auto visuals = json::array();
+        if (e.elemType == FX_ELEM_TYPE_DECAL)
+        {
+            for (auto i = 0; i < e.visualCount && e.visuals.markArray; i++)
+            {
+                const auto& mark = e.visuals.markArray[i];
+                visuals.push_back(json::array({mark.materials[0] ? Str(mark.materials[0]->info.name) : json(nullptr),
+                                               mark.materials[1] ? Str(mark.materials[1]->info.name) : json(nullptr)}));
+            }
+        }
+        else if (e.visualCount > 1)
+        {
+            for (auto i = 0; i < e.visualCount && e.visuals.array; i++)
+                visuals.push_back(Visual(e.visuals.array[i], e.elemType));
+        }
+        else if (e.visualCount == 1)
+            visuals.push_back(Visual(e.visuals.instance, e.elemType));
+        j["visuals"] = visuals;
+
+        j["collMins"] = Vec(e.collMins.v, 3);
+        j["collMaxs"] = Vec(e.collMaxs.v, 3);
+        j["effectOnImpact"] = Str(e.effectOnImpact.name);
+        j["effectOnDeath"] = Str(e.effectOnDeath.name);
+        j["effectEmitted"] = Str(e.effectEmitted.name);
+        j["emitDist"] = Range(e.emitDist);
+        j["emitDistVariance"] = Range(e.emitDistVariance);
+        j["effectAttached"] = Str(e.effectAttached.name);
+
+        if (e.elemType == FX_ELEM_TYPE_TRAIL && e.extended.trailDef)
+        {
+            const auto& t = *e.extended.trailDef;
+            auto verts = json::array();
+            for (auto i = 0; i < t.vertCount; i++)
+                verts.push_back(json::array({t.verts[i].pos.x, t.verts[i].pos.y, t.verts[i].normal.x, t.verts[i].normal.y, t.verts[i].texCoord}));
+            auto inds = json::array();
+            for (auto i = 0; i < t.indCount; i++)
+                inds.push_back(t.inds[i]);
+            j["trail"] = json{{"scrollTimeMsec", t.scrollTimeMsec}, {"repeatDist", t.repeatDist}, {"splitDist", t.splitDist}, {"verts", verts}, {"inds", inds}};
+        }
+
+        if (e.elemType == FX_ELEM_TYPE_SPOT_LIGHT && e.extended.spotLightDef)
+        {
+            const auto& s = *e.extended.spotLightDef;
+            j["spotLight"] = json{{"fovInnerFraction", s.fovInnerFraction}, {"startRadius", s.startRadius}, {"endRadius", s.endRadius}};
+        }
+
+        j["sortOrder"] = static_cast<int>(e.sortOrder);
+        j["lightingFrac"] = static_cast<int>(static_cast<uint8_t>(e.lightingFrac));
+        j["alphaFadeTimeMsec"] = e.alphaFadeTimeMsec;
+        j["maxWindStrength"] = e.maxWindStrength;
+        j["spawnIntervalAtMaxWind"] = e.spawnIntervalAtMaxWind;
+        j["lifespanAtMaxWind"] = e.lifespanAtMaxWind;
+        if (e.elemType == FX_ELEM_TYPE_CLOUD)
+            j["cloudDensityRange"] = Range(e.u.cloudDensityRange);
+        else
+            j["billboardTrim"] = json::array({e.u.billboard.topWidth, e.u.billboard.bottomWidth});
+        j["spawnSound"] = Str(e.spawnSound.spawnSound);
+        j["billboardPivot"] = json::array({e.billboardPivot.x, e.billboardPivot.y});
+
+        return j;
+    }
+
+    json FxToJson(const FxEffectDef& fx)
+    {
+        json j;
+        j["_type"] = "fx";
+        j["_version"] = 1;
+        j["_game"] = "t6";
+        j["flags"] = fx.flags;
+        j["efPriority"] = static_cast<int>(fx.efPriority);
+        j["elemDefCountLooping"] = fx.elemDefCountLooping;
+        j["elemDefCountOneShot"] = fx.elemDefCountOneShot;
+        j["elemDefCountEmission"] = fx.elemDefCountEmission;
+        j["totalSize"] = fx.totalSize;
+        j["msecLoopingLife"] = fx.msecLoopingLife;
+        j["msecNonLoopingLife"] = fx.msecNonLoopingLife;
+        j["boundingBoxDim"] = Vec(fx.boundingBoxDim.v, 3);
+        j["boundingBoxCentre"] = Vec(fx.boundingBoxCentre.v, 3);
+        j["occlusionQueryDepthBias"] = fx.occlusionQueryDepthBias;
+        j["occlusionQueryFadeIn"] = fx.occlusionQueryFadeIn;
+        j["occlusionQueryFadeOut"] = fx.occlusionQueryFadeOut;
+        j["occlusionQueryScaleRange"] = Range(fx.occlusionQueryScaleRange);
+
+        auto elems = json::array();
+        const auto count = fx.elemDefCountLooping + fx.elemDefCountOneShot + fx.elemDefCountEmission;
+        for (auto i = 0; i < count && fx.elemDefs; i++)
+            elems.push_back(ElemDef(fx.elemDefs[i]));
+        j["elemDefs"] = elems;
+
+        return j;
+    }
+} // namespace
+
+namespace fx
+{
+    void JsonDumperT6::DumpAsset(AssetDumpingContext& context, const XAssetInfo<AssetFx::Type>& asset)
+    {
+        const auto assetFile = context.OpenAssetFile(GetJsonFileNameForAssetNameT6(asset.m_name));
+        if (!assetFile)
+            return;
+
+        *assetFile << std::setw(4) << FxToJson(*asset.Asset()) << "\n";
+    }
+} // namespace fx
